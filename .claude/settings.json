{
  "permissions": {
    "allow": [
      "Bash(git status *)",
      "Bash(git log *)",
      "Bash(git diff *)",
      "Bash(git show *)",
      "Bash(git branch *)",
      "Bash(git tag *)"
    ],
    "deny": [
      "Read(src/.env)",
      "Read(src/.env-prod.)",
      "Read(src/envs/**)",
      "Read(container/prod/nginx/ssl*)",
      "Read(container/prod/nginx/ssl/**)",
      "Read(pgdata/**)"
    ],
    "ask": [
      "Bash(ssh * reboot*)",
      "Bash(ssh * docker compose down*)",
      "Bash(ssh * docker-compose down*)",
      "Bash(ssh * apt upgrade*)",
      "Bash(ssh * apt-get upgrade*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/guard_secrets.py\"",
            "timeout": 10,
            "statusMessage": "檢查是否讀取機密"
          }
        ]
      }
    ]
  }
}
